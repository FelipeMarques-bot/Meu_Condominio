# Produção — Meu Condomínio (Ubuntu + Caddy + Postgres)
# Copie para /srv/meu-condominio/.env e ajuste. Nunca versione o .env.
DEBUG=False
SECRET_KEY=gere-com-openssl-rand-hex-32
ALLOWED_HOSTS=meucondominio.com.br,www.meucondominio.com.br
CSRF_TRUSTED_ORIGINS=https://meucondominio.com.br,https://www.meucondominio.com.br

# Banco local (só escuta em 127.0.0.1)
DATABASE_URL=postgres://meucond:SENHA@127.0.0.1:5432/meucondominio
DB_SSLMODE=disable

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

ADMIN_URL=gestao-aleatoria-8f2c/
CONFIAR_NO_PROXY=True

CONTATO_EMAIL=contato@meucondominio.com.br
SITE_NOME=Meu Condomínio

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT=5
CHAVE_CRIPTOGRAFIA=gere-outra-chave-estavel

# E-mail (opcional)
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=contato@meucondominio.com.br
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Meu Condomínio <nao-responda@meucondominio.com.br>

# Credenciais de Pix/AbacatePay NÃO vão aqui:
# ficam por condomínio no banco (ConfiguracaoCondominio), editadas no painel.

# Superusuário criado no deploy
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
