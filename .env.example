DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe vazio para usar SQLite no desenvolvimento.
# Neon: use o host com -pooler e sslmode=require.
DATABASE_URL=

# Opcional: servidor do Vite em desenvolvimento (npm run dev).
VITE_DEV_SERVER=

# Contato padrão exibido no rodapé.
CONTATO_EMAIL=contato@meucondominio.com.br

# Bot único da plataforma. Cada condomínio ativa o Telegram nas configurações
# e informa o chat_id do grupo administrativo.
TELEGRAM_BOT_TOKEN=

# Chave estavel para criptografar credenciais de gateway. Sem ela, deriva da SECRET_KEY.
CHAVE_CRIPTOGRAFIA=
