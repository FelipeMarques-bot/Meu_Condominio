DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe vazio para usar SQLite no desenvolvimento.
# Neon: use o host com -pooler e sslmode=require.
DATABASE_URL=

# Opcional: servidor do Vite em desenvolvimento (npm run dev).
VITE_DEV_SERVER=

# Contato padrão exibido no rodapé.
CONTATO_EMAIL=labintelligenceappoiments@gmail.com

# Bot único da plataforma. Cada condomínio ativa o Telegram nas configurações
# e informa o chat_id do grupo administrativo.
TELEGRAM_BOT_TOKEN=

# E-mail transacional. No Render free o SMTP e bloqueado; use Brevo ou Resend
# por HTTPS. A API tem prioridade sobre o SMTP quando configurada.
EMAIL_API_PROVIDER=
EMAIL_API_KEY=

# E-mail (SMTP) usado nos avisos de reserva. Sem estas variaveis, os
# e-mails nao saem em producao.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Meu Condomínio <labintelligenceappoiments@gmail.com>

# Plano mensal da plataforma. O Pix e o WhatsApp sao do dono da plataforma.
TRIAL_DIAS=14
TRIAL_JANELA_DIAS=30
ASSINATURA_DIAS=30
CARENCIA_DIAS=5
PLANO_PIX_CHAVE=
PLANO_PIX_BENEFICIARIO=MEU CONDOMINIO
PLANO_PIX_CIDADE=BRASIL
PLANO_WHATSAPP=
PLANO_WHATSAPP_MENSAGEM=
PLANO_WHATSAPP_MENSAGEM_LANDING=

# Confirmação de e-mail no cadastro público (padrão: ligado em produção).
EXIGIR_CONFIRMACAO_EMAIL=True

# Cloudflare Turnstile (Captcha). Sem as duas chaves, o Captcha fica desligado.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Token do agendador de prazos. Um cron externo deve chamar
# /tarefas/prazos/<token>/ para expirar reservas e enviar lembretes.
TAREFAS_TOKEN=

# Roda prazos/lembretes sozinho a cada 6h dentro do proprio servidor.
# Em producao ja vem ligado; use False se preferir um cron externo.
AGENDADOR_INTERNO=True

# Chave estável para criptografar credenciais de gateway. Sem ela, deriva da SECRET_KEY.
CHAVE_CRIPTOGRAFIA=

# Caminho do Django admin. Em produção, use algo diferente de "admin/".
ADMIN_URL=admin/

# Confia no IP de X-Forwarded-For para o rate limit (padrão: True fora do DEBUG).
# CONFIAR_NO_PROXY=True

# Superusuário criado no deploy (build.sh). Sem estas variáveis, nada é criado.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=



# Midia persistente (Cloudflare R2 / qualquer S3 compativel).
# Sem estas variaveis, logos e comprovantes ficam no disco local (efemero no Render).
STORAGE_S3_BUCKET=
STORAGE_S3_PRIVATE_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_PUBLIC_DOMAIN=

# Cloudinary (opcional): usado quando o R2 nao esta configurado.
# Prioridade: R2 > Cloudinary > disco local.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
